# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요.

# 관리자 로그인 비밀번호 (/admin/login)
ADMIN_PASSWORD=
# 세션 쿠키 서명용 비밀 키 (32바이트 이상 임의 문자열)
SESSION_SECRET=

# Gemini / Vertex AI Express Mode API 키 (네이버 블로그 레시피 자동 정리용)
GEMINI_API_KEY=

# 사이트 기본 주소 (메타데이터, sitemap, JSON-LD 에 사용)
NEXT_PUBLIC_SITE_URL=https://maksik-recipe.com

# Google AdSense (비워 두면 광고 자리 표시만 노출)
# 예: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=
# 레시피 하단 광고 단위 슬롯 ID
NEXT_PUBLIC_ADSENSE_SLOT=
